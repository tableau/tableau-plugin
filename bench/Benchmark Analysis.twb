      </column>
      <column caption='# Tool Calls per Test Run' datatype='real' name='[Calculation_0054884663701504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ fixed [source_file] : [Calculation_2162922039341060] })' />
      </column>
      <column caption='Is Tableau Tool Call' datatype='boolean' name='[Calculation_0054884664725505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS(lower([name]),&apos;tableau::&apos;)' />
        <aliases>
          <alias key='false' value='Non-Tableau' />
          <alias key='true' value='Tableau' />
        </aliases>
      </column>
      <column caption='Command Groupings' datatype='string' name='[Calculation_0054884665745410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if contains(lower([name]),&apos;pip install&apos;) then &apos;Installing dependencies&apos;&#10;elseif contains(lower([name]),&apos;curl&apos;) then &apos;Downloading files&apos;&#10;elseif contains(lower([name]),&apos;sed&apos;) or contains(lower([name]),&apos;xmllint&apos;) then &apos;Text manipulation&apos;&#10;elseif contains(lower([name]),&apos;rg&apos;) then &apos;Searching Text&apos;&#10;elseif contains(lower([name]),&apos;diff&apos;) then &apos;Comparing files&apos;&#10;elseif contains(lower([name]),&apos;bin/python &apos;) then &apos;Executing Python&apos;&#10;elseif contains(lower([name]),&apos;zip&apos;) then &apos;Zip/Unzip&apos;&#10;elseif contains(lower([name]),&apos;cp&apos;) or contains(lower([name]),&apos;mv&apos;) then &apos;Moving files&apos;&#10;elseif contains(lower([name]),&apos;rm&apos;) then &apos;Cleanup&apos;&#10;else &apos;Other&apos;&#10;end' />
      </column>
      <column aggregation='Sum' caption='Call Type Filter' datatype='integer' name='[Calculation_0054884669911048]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 0054884669198339]' />
      </column>
      <column aggregation='Avg' caption='Test Run Duration' datatype='real' default-format='*n:ss' name='[Calculation_2162922015559683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [source_file]: sum([duration]) / 86400}' />
      </column>
      <column caption='# Tool Calls' datatype='integer' name='[Calculation_2162922039341060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([segment_type]=&quot;tool_call&quot;,1,0))' />
      </column>
      <column caption='View Type: Test Details' datatype='boolean' name='[Calculation_3651112330600448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 0054884670889993]=1' />
      </column>
      <column caption='Error Types' datatype='string' name='[Calculation_3651112331788290]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS(lower([error]),&apos;rejected due to unacceptable risk&apos;) then &apos;Action too risky&apos;&#10;elseif CONTAINS(lower([error]),&apos;tool call error:&apos;) then &apos;Tool call error&apos;&#10;elseif ISNULL([error]) then null&#10;else &apos;Other&apos;&#10;end' />
      </column>
      <column caption='Error Sub-Types' datatype='string' name='[Calculation_3651112332656643]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_3651112331788290] = &apos;Tool call error&apos; then&#10;    REGEXP_EXTRACT([error], &apos;Tableau/([^`\n]+)&apos;)&#10;elseif [Calculation_3651112331788290] = &apos;Other&apos; then&#10;    if CONTAINS(lower([error]),&apos;resources/read failed for `tablea&apos;) then &quot;Couldn&apos;t fetch file from S3&quot;&#10;    else &apos;Other&apos;&#10;    end&#10;elseif [Calculation_3651112331788290] = &apos;Action too risky&apos; then&#10;    REGEXP_REPLACE(&#10;        REGEXP_EXTRACT([error], &apos;Reason:\s*(.*)&apos;), &#10;      &apos;[\&quot;}]+$&apos;, &#10;    &apos;&apos;&#10;    )&#10;end' />
      </column>
      <column caption='Error Type Filter' datatype='string' name='[Calculation_3651112338681861]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3651112338456580]' />
      </column>
      <column caption='Test Run Filter' datatype='boolean' name='[Calculation_3651112351502349]' role='dimension' type='nominal'>
