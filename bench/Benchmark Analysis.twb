      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1w80izw0g2um40179k9j71d49x46].[avg:Calculation_2162922015559683:qk]&quot;' value='Avg Duration' />
          <alias key='&quot;[federated.1w80izw0g2um40179k9j71d49x46].[ctd:source_file:qk]&quot;' value='# Test Runs' />
