      <filter class='relative-date' column='[Sales Data].[none:Transaction Date:qk]' first-period='-99' include-future='true' include-null='false' last-period='0' period-type-v2='day' />
      <slices>
        <column>[Sales Data].[none:Transaction Date:qk]</column>
      </slices>
