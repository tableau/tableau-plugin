  <worksheet name='ARR Trend'>
<table>
    <view>
      <datasources>
        <datasource caption='Sales Data' name='federated.0fixture1sales2data' />
      </datasources>
      <datasource-dependencies datasource='federated.0fixture1sales2data'>
        <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[Revenue]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
        <column aggregation='Year' datatype='date' default-type='ordinal' layered='true' name='[Transaction Date]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
        <column-instance column='[Transaction Date]' derivation='None' name='[none:Transaction Date:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Revenue]' derivation='Sum' name='[sum:Revenue:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Transaction Date]' derivation='Day-Trunc' name='[tdy:Transaction Date:qk]' pivot='key' type='quantitative' />
      </datasource-dependencies>
      <filter class='relative-date' column='[federated.0fixture1sales2data].[none:Transaction Date:qk]' first-period='-99' include-future='true' include-null='false' last-period='0' period-type-v2='day' />
