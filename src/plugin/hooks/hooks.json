{
  "description": "Prepare the Tableau plugin's shared Python environment.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/run_python.py\" --bootstrap",
            "timeout": 300,
            "statusMessage": "Preparing Tableau Python dependencies"
          }
        ]
      }
    ]
  }
}
